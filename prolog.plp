parent(peter, sophia).
parent(linda, sophia).

% ========== RULES ==========

% Basic relationships
father(Father, Child) :- male(Father), parent(Father, Child).
mother(Mother, Child) :- female(Mother), parent(Mother, Child).

% Grandparents
grandparent(GP, Grandchild) :- parent(GP, X), parent(X, Grandchild).

% Siblings (share at least one parent)
sibling(X, Y) :- parent(P, X), parent(P, Y), X \= Y.

% Children
child(Child, Parent) :- parent(Parent, Child).

% Grandchildren
grandchild(Child, Grandparent) :- grandparent(Grandparent, Child).

% Uncles (brother of one's parent)
uncle(Uncle, Person) :- 
    male(Uncle),
    parent(Parent, Person),
    sibling(Uncle, Parent).

% Aunts (sister of one's parent)
aunt(Aunt, Person) :-
    female(Aunt),
    parent(Parent, Person),
    sibling(Aunt, Parent).

% Cousins (children of siblings)
cousin(Cousin1, Cousin2) :-
    parent(P1, Cousin1),
    parent(P2, Cousin2),
    sibling(P1, P2),
    Cousin1 \= Cousin2.

% First cousins (share grandparents)
first_cousin(C1, C2) :-
    grandparent(GP, C1),
    grandparent(GP, C2),
    C1 \= C2,
    \+ sibling(C1, C2).

% Descendants
descendant(Descendant, Ancestor) :- parent(Ancestor, Descendant).
descendant(Descendant, Ancestor) :- parent(Ancestor, X), descendant(Descendant, X).

% Ancestors
ancestor(Ancestor, Descendant) :- descendant(Descendant, Ancestor).


