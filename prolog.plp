% ============================================
% BASIC FAMILY TREE
% ============================================

% Facts - Gender
male(john).
male(robert).
male(michael).
male(david).

female(susan).
female(linda).
female(mary).
female(sarah).

% Facts - Parent relationships
parent(john, michael).
parent(susan, michael).
parent(john, linda).
parent(susan, linda).
parent(michael, david).
parent(linda, mary).
parent(robert, sarah).
parent(mary, sarah).

% Rules
father(Father, Child) :- male(Father), parent(Father, Child).
mother(Mother, Child) :- female(Mother), parent(Mother, Child).
grandparent(GP, Grandchild) :- parent(GP, X), parent(X, Grandchild).
sibling(X, Y) :- parent(P, X), parent(P, Y), X \= Y.
brother(Brother, Person) :- male(Brother), sibling(Brother, Person).
sister(Sister, Person) :- female(Sister), sibling(Sister, Person).


